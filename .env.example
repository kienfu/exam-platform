# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (local Windows service, see README). SQLAlchemy URL, psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://quizai:CHANGE_ME@localhost:5432/quizai
# Used by pytest only; must be a different database from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://quizai:CHANGE_ME@localhost:5432/quizai_test

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Local file storage root (ignored by git)
STORAGE_DIR=./data

# Worker
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
