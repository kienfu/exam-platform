{
  "name": "quizai-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "echo 'e2e (Playwright) is added in a later milestone'",
    "gen:openapi": "cd ../backend && uv run python scripts/export_openapi.py",
    "gen:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "gen:api": "pnpm gen:openapi && pnpm gen:types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.15.0"
}
